# Local environment configuration for Denial Attribution Research
# Copy to .env and fill in values only when running LLM-in-the-loop experiments (Phase 4+).
# Never commit .env or store real credentials in experiment logs.

# Optional: Local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional: API-based LLM provider (Phase 4+)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Reproducibility seed for deterministic experiment runs
EXPERIMENT_SEED=42
